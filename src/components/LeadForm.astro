<section class="leadFormSection">
  <div class="leadFormContent">
    <h2 class="leadFormTitle">
      Book a Free Home Visit<br />
      We'll design the right system for your home
    </h2>
    <p class="subtitle">
      Local experts. At a time that suits you.
    </p>

    <form 
      class="leadForm"
      name="lead"
      id="leadForm"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/thank-you"
    >
      <!-- Required for Netlify -->
      <input type="hidden" name="form-name" value="lead" />
      <input type="hidden" name="bot-field" />

      <!-- Name -->
      <input
        type="text"
        name="name"
        class="formInput"
        placeholder="Name"
        required
      />

      <!-- Phone -->
      <input
        type="tel"
        name="phone"
        class="formInput"
        placeholder="Phone number"
        required
      />

      <!-- Address -->
      <input
        type="text"
        name="address"
        class="formInput"
        placeholder="Address"
        autocomplete="street-address"
        required
      />  

      <!-- Preferred install time -->
      <input
        type="text"
        name="preferredInstallTime"
        class="formInput"
        placeholder="How soon would you like it installed? (e.g. This Friday)"
      />
      
      <button type="submit" class="leadFormButton">
        Request Quote
      </button>
    </form>

    <p class="leadFormNote">
      Local team. No call centres. We'll contact you shortly.
    </p>
  </div>
</section>

<style>
  .leadFormSection {
    background-color: #ff9800;
    padding: 80px 20px;
    color: white;
  }

  .leadFormContent {
    max-width: 520px;
    margin: 0 auto;
    text-align: center;
  }

  .leadFormTitle {
    font-size: 32px;
    margin-bottom: 30px;
  }

  .leadForm {
    display: flex;
    flex-direction: column;
  }

  .formInput {
    padding: 14px;
    margin-bottom: 14px;
    border-radius: 6px;
    border: none;
    font-size: 15px;
  }

  .leadFormButton {
    background-color: rgb(13, 13, 14);
    color: #ffffff;
    border: none;
    padding: 16px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    border-radius: 6px;
  }

  .leadFormNote {
    margin-top: 16px;
    font-size: 14px;
    opacity: 0.9;
  }
</style>