    <script>
      // @ts-ignore
      window.dataLayer = window.dataLayer || [];
      // @ts-ignore
      function gtag(){dataLayer.push(arguments);}
      // @ts-ignore
      window.gtag = gtag;

      gtag('js', new Date());
      gtag('config', 'G-E7JCW56D9G');
    </script>

  </head>
  <body>
    <slot />
  </body>
</html>