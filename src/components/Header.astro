---
const pathname = Astro.url.pathname;

const navigation = [
  {
    label: "Solar",
    href: "/solar-townsville",
  },
  {
    label: "Battery Storage",
    href: "/battery-installation-townsville",
  },
  {
    label: "Our Installs",
    href: "/#our-installs",
  },
  {
    label: "Brands",
    href: "/#brands",
  },
  {
    label: "About Us",
    href: "/#about-us",
  },
  {
    label: "FAQ",
    href: "/#faq",
  },
];

const isActive = (href: string) => {
  if (href.startsWith("/#")) {
    return false;
  }

  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="site-header" data-header>
  <div class="header-container">

    <!-- Logo -->
    <a
      href="/"
      class="brand"
      aria-label="Sunnyville Solar home"
    >
      <img
        src="/images/logo.png"
        alt="Sunnyville Solar"
        class="brand-logo"
        width="230"
        height="78"
      />
    </a>

    <!-- Desktop navigation -->
    <nav class="desktop-nav" aria-label="Main navigation">
      {
        navigation.map((item) => (
          <a
            href={item.href}
            class:list={[
              "nav-link",
              { active: isActive(item.href) },
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop actions -->
    <div class="desktop-actions">
      <a
        href="tel:0401846864"
        class="phone"
        aria-label="Call Sunnyville Solar"
      >
        <span class="phone-small">Talk to a local specialist</span>
        <span class="phone-number">0401 846 864</span>
      </a>

      <a href="/#get-a-quote" class="quote-button">
        <span>Book a Free Site Visit</span>

        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          class="quote-arrow"
        >
          <path
            d="M5 12h14M13 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      class="menu-button"
      type="button"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-menu-button
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

  </div>

  <!-- Mobile menu -->
  <div
    class="mobile-menu"
    id="mobile-menu"
    data-mobile-menu
  >
    <div class="mobile-menu-inner">

      <nav class="mobile-nav" aria-label="Mobile navigation">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              class:list={[
                "mobile-nav-link",
                { active: isActive(item.href) },
              ]}
            >
              <span>{item.label}</span>

              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M5 12h14M13 6l6 6-6 6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          ))
        }
      </nav>

      <div class="mobile-actions">
        <a
          href="/#get-a-quote"
          class="mobile-quote-button"
        >
          Book a Free Site Visit
        </a>

        <a
          href="tel:0401846864"
          class="mobile-phone"
        >
          <span>Call Sunnyville Solar</span>
          <strong>0401 846 864</strong>
        </a>

        <div class="mobile-trust">
          <span>Townsville local team</span>
          <span>400+ installations</span>
          <span>10-year workmanship warranty</span>
        </div>
      </div>

    </div>
  </div>
</header>

<script>
  const header =
    document.querySelector<HTMLElement>("[data-header]");

  const menuButton =
    document.querySelector<HTMLButtonElement>("[data-menu-button]");

  const mobileMenu =
    document.querySelector<HTMLElement>("[data-mobile-menu]");

  const updateHeader = () => {
    if (!header) return;

    header.classList.toggle(
      "scrolled",
      window.scrollY > 20
    );
  };

  updateHeader();

  window.addEventListener("scroll", updateHeader, {
    passive: true,
  });

  menuButton?.addEventListener("click", () => {
    const isOpen =
      menuButton.getAttribute("aria-expanded") === "true";

    const newState = !isOpen;

    menuButton.setAttribute(
      "aria-expanded",
      String(newState)
    );

    menuButton.classList.toggle("open", newState);
    mobileMenu?.classList.toggle("open", newState);

    document.body.classList.toggle(
      "menu-open",
      newState
    );
  });

  mobileMenu
    ?.querySelectorAll("a")
    .forEach((link) => {
      link.addEventListener("click", () => {
        menuButton?.setAttribute(
          "aria-expanded",
          "false"
        );

        menuButton?.classList.remove("open");
        mobileMenu.classList.remove("open");
        document.body.classList.remove("menu-open");
      });
    });
</script>

<style is:global>
  :root {
    --header-height: 94px;
    --header-black: #070a0c;
    --header-dark: rgba(7, 10, 12, 0.95);
    --header-border: rgba(255, 255, 255, 0.1);
    --header-white: #ffffff;
    --header-muted: #a7b0b5;
    --brand-orange: #f39a22;
    --brand-orange-light: #ffb34b;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: calc(var(--header-height) + 24px);
  }

  body.menu-open {
    overflow: hidden;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;

    background:
      linear-gradient(
        180deg,
        rgba(4, 7, 9, 0.98) 0%,
        rgba(8, 11, 13, 0.94) 100%
      );

    border-bottom: 1px solid var(--header-border);

    transition:
      background 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease,
      backdrop-filter 220ms ease;
  }

  .site-header.scrolled {
    background: var(--header-dark);

    border-color:
      rgba(255, 255, 255, 0.07);

    box-shadow:
      0 18px 45px rgba(0, 0, 0, 0.27),
      0 3px 9px rgba(0, 0, 0, 0.17);

    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .header-container {
    width: min(100% - 40px, 1450px);
    min-height: var(--header-height);
    margin-inline: auto;

    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(24px, 3vw, 55px);
  }

  /* Logo */

  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    width: auto;
    height: 120px;
    object-fit: contain;

    transition:
      height 220ms ease,
      transform 220ms ease,
      filter 220ms ease;
  }

  .brand:hover .brand-logo {
    transform: translateY(-1px);
    filter: brightness(1.04);
  }

  .site-header.scrolled .brand-logo {
    height: 180px;
  }

  /* Desktop navigation */

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(18px, 1.8vw, 32px);
  }

  .nav-link {
    position: relative;

    display: inline-flex;
    min-height: var(--header-height);
    align-items: center;

    color: rgba(255, 255, 255, 0.77);

    font-size: 0.89rem;
    font-weight: 600;
    letter-spacing: 0.015em;
    line-height: 1;

    text-decoration: none;
    white-space: nowrap;

    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .nav-link::after {
    content: "";

    position: absolute;
    right: 0;
    bottom: 22px;
    left: 0;

    height: 2px;

    border-radius: 999px;

    background:
      linear-gradient(
        90deg,
        var(--brand-orange),
        var(--brand-orange-light)
      );

    box-shadow:
      0 0 12px rgba(243, 154, 34, 0.35);

    transform: scaleX(0);
    transform-origin: center;

    transition: transform 180ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--header-white);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  /* Desktop actions */

  .desktop-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
  }

  .phone {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;

    text-decoration: none;
  }

  .phone-small {
    color: var(--header-muted);

    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.065em;
    line-height: 1;
    text-transform: uppercase;
  }

  .phone-number {
    color: var(--header-white);

    font-size: 0.95rem;
    font-weight: 750;
    letter-spacing: 0.02em;

    transition: color 180ms ease;
  }

  .phone:hover .phone-number {
    color: var(--brand-orange-light);
  }

  .quote-button {
    display: inline-flex;
    min-height: 50px;
    padding: 0 22px;

    align-items: center;
    justify-content: center;
    gap: 10px;

    border: 1px solid rgba(255, 184, 80, 0.72);
    border-radius: 8px;

    background:
      linear-gradient(
        135deg,
        #ffb349 0%,
        #f39820 52%,
        #e9840d 100%
      );

    box-shadow:
      0 12px 28px rgba(243, 154, 34, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.34);

    color: #17110a;

    font-size: 0.89rem;
    font-weight: 800;
    letter-spacing: 0.005em;
    line-height: 1;

    text-decoration: none;
    white-space: nowrap;

    transition:
      transform 180ms ease,
      box-shadow 180ms ease,
      filter 180ms ease;
  }

  .quote-button:hover {
    transform: translateY(-2px);

    box-shadow:
      0 17px 38px rgba(243, 154, 34, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.42);

    filter: brightness(1.04);
  }

  .quote-button:active {
    transform: translateY(0);
  }

  .quote-arrow {
    width: 18px;
    height: 18px;

    transition: transform 180ms ease;
  }

  .quote-button:hover .quote-arrow {
    transform: translateX(3px);
  }

  /* Mobile button */

  .menu-button {
    display: none;

    width: 47px;
    height: 47px;
    padding: 10px;

    border:
      1px solid rgba(255, 255, 255, 0.14);

    border-radius: 8px;

    background:
      rgba(255, 255, 255, 0.04);

    cursor: pointer;

    transition:
      background 180ms ease,
      border-color 180ms ease;
  }

  .menu-button:hover {
    background:
      rgba(255, 255, 255, 0.07);

    border-color:
      rgba(255, 255, 255, 0.22);
  }

  .menu-button span {
    display: block;

    width: 23px;
    height: 2px;
    margin: 5px auto;

    border-radius: 999px;

    background: white;

    transition:
      transform 200ms ease,
      opacity 200ms ease;
  }

  .menu-button.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-button.open span:nth-child(2) {
    opacity: 0;
  }

  .menu-button.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile menu */

  .mobile-menu {
    display: none;
  }

  @media (max-width: 1270px) {
    .phone {
      display: none;
    }

    .desktop-nav {
      gap: 20px;
    }

    .nav-link {
      font-size: 0.84rem;
    }

    .quote-button {
      padding-inline: 18px;
      font-size: 0.84rem;
    }
  }

  @media (max-width: 1020px) {
    :root {
      --header-height: 78px;
    }

    .header-container {
      width: min(100% - 28px, 1450px);
      grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .desktop-actions {
      display: none;
    }

    .menu-button {
      display: block;
    }

    .brand-logo,
    .site-header.scrolled .brand-logo {
      height: 57px;
    }

    .mobile-menu {
      position: fixed;
      top: var(--header-height);
      right: 0;
      bottom: 0;
      left: 0;

      display: block;

      padding:
        24px 18px
        max(35px, env(safe-area-inset-bottom));

      overflow-y: auto;

      background:
        radial-gradient(
          circle at 100% 0%,
          rgba(243, 154, 34, 0.12),
          transparent 38%
        ),
        radial-gradient(
          circle at 0% 100%,
          rgba(28, 117, 188, 0.1),
          transparent 35%
        ),
        #070a0c;

      opacity: 0;
      visibility: hidden;

      transform: translateY(-12px);

      transition:
        opacity 200ms ease,
        visibility 200ms ease,
        transform 200ms ease;
    }

    .mobile-menu.open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .mobile-menu-inner {
      width: min(100%, 620px);
      margin-inline: auto;
    }

    .mobile-nav {
      display: flex;
      flex-direction: column;
    }

    .mobile-nav-link {
      display: flex;
      min-height: 62px;
      padding: 0 4px;

      align-items: center;
      justify-content: space-between;

      border-bottom:
        1px solid rgba(255, 255, 255, 0.09);

      color:
        rgba(255, 255, 255, 0.88);

      font-size: 1.04rem;
      font-weight: 650;

      text-decoration: none;

      transition:
        color 180ms ease,
        padding-left 180ms ease;
    }

    .mobile-nav-link svg {
      width: 19px;
      height: 19px;

      color: var(--brand-orange);

      transition: transform 180ms ease;
    }

    .mobile-nav-link:hover {
      padding-left: 7px;
      color: white;
    }

    .mobile-nav-link:hover svg {
      transform: translateX(4px);
    }

    .mobile-nav-link.active {
      color: var(--brand-orange-light);
    }

    .mobile-actions {
      margin-top: 30px;
    }

    .mobile-quote-button {
      display: flex;
      min-height: 58px;

      align-items: center;
      justify-content: center;

      border:
        1px solid rgba(255, 184, 80, 0.72);

      border-radius: 8px;

      background:
        linear-gradient(
          135deg,
          #ffb349,
          #ed8b15
        );

      box-shadow:
        0 14px 32px rgba(243, 154, 34, 0.2);

      color: #17110a;

      font-size: 1rem;
      font-weight: 800;

      text-decoration: none;
    }

    .mobile-phone {
      display: flex;
      margin-top: 16px;
      padding: 18px;

      flex-direction: column;
      align-items: center;
      gap: 6px;

      border:
        1px solid rgba(255, 255, 255, 0.11);

      border-radius: 8px;

      background:
        rgba(255, 255, 255, 0.035);

      color: white;
      text-decoration: none;
    }

    .mobile-phone span {
      color: var(--header-muted);

      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .mobile-phone strong {
      font-size: 1.12rem;
      letter-spacing: 0.02em;
    }

    .mobile-trust {
      display: grid;
      margin-top: 22px;
      gap: 9px;

      color: #aab2b7;

      font-size: 0.78rem;
      text-align: center;
    }

    .mobile-trust span::before {
      content: "✓";
      margin-right: 7px;
      color: var(--brand-orange);
      font-weight: 800;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      width: calc(100% - 22px);
    }

    .brand-logo,
    .site-header.scrolled .brand-logo {
      height: 52px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>