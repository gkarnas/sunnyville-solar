---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";

---

<BaseLayout>
  
  <!-- Your entire battery section code goes here -->

</BaseLayout>

<section class="batteryHero">
  <div class="container">
    <h1>Home Battery Installation in Townsville</h1>
    <p class="sub">
      Store your solar energy. Reduce grid reliance. Stay powered during outages.
    </p>

    <a href="#quote" class="ctaPrimary">Request Battery Assessment</a>
  </div>
</section>

<section class="batteryWhy">
  <div class="container">
    <h2>Why Install a Battery?</h2>
    <ul>
      <li> Free electricity at night</li>
      <li> Protection during blackouts</li>
      <li> Reduce peak grid usage</li>
        </ul>
  </div>
</section>

<section class="batteryTrust">
  <div class="container">
    <h2>Installed by a Local Electrician</h2>
    <p>
      All installations are CEC compliant and designed specifically for your homes.
      No sales reps. Direct communication with the installer.
    </p>
  </div>
</section>

<section id="quote" class="batteryForm">
  <div class="container">
    <h2>Request a Battery Assessment</h2>

    <form 
      name="battery-lead"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      action="/thank-you/"
    >
      <input type="hidden" name="form-name" value="battery-lead" />
      <input type="hidden" name="bot-field" />

      <input type="text" name="name" placeholder="Name" required />
      <input type="tel" name="phone" placeholder="Phone number" required />
      <input type="text" name="address" placeholder="Address" required />
      <input type="text" name="existingSystem" placeholder="Do you already have solar?" />

      <button type="submit">Book My Assessment</button>
    </form>
  </div>
</section>

<style>
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
  }

  .batteryHero {
    background: #111;
    color: white;
    padding: 100px 20px;
  }

  .batteryHero h1 {
    font-size: 36px;
    margin-bottom: 20px;
  }

  .sub {
    font-size: 18px;
    margin-bottom: 30px;
  }

  .ctaPrimary {
    background: #ff9800;
    color: white;
    padding: 16px 30px;
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
  }

  .batteryWhy {
    padding: 80px 20px;
  }

  .batteryWhy ul {
    list-style: none;
    padding: 0;
    font-size: 18px;
    line-height: 2;
  }

  .batteryTrust {
    background: #f5f5f5;
    padding: 80px 20px;
  }

  .batteryForm {
    padding: 80px 20px;
  }

  .batteryForm input {
    display: block;
    width: 100%;
    max-width: 500px;
    margin: 12px auto;
    padding: 14px;
  }

  .batteryForm button {
    background: #111;
    color: white;
    border: none;
    padding: 16px 30px;
    font-weight: bold;
    cursor: pointer;
  }
</style>
  <Footer />
